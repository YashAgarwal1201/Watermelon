{
  "name": "watermelon-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Polyglot Microfrontend Monorepo (Vue 3 Host + React, Vue, Svelte, SolidJS, Angular Remotes)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:all": "bash scripts/start-all.sh",
    "dev:host": "bash scripts/dev.sh --remote=host",
    "dev:vite-react": "bash scripts/dev.sh --remote=v-react",
    "dev:vite-vue": "bash scripts/dev.sh --remote=v-vue",
    "dev:vite-svelte": "bash scripts/dev.sh --remote=v-svelte",
    "dev:vite-solid": "bash scripts/dev.sh --remote=v-solid",
    "dev:webpack-react": "bash scripts/dev.sh --remote=w-react",
    "dev:webpack-vue": "bash scripts/dev.sh --remote=w-vue",
    "dev:angular": "bash scripts/dev.sh --remote=angular",
    "dev:wc-lit": "bash scripts/dev.sh --remote=wc-lit",
    "dev:wc-vue": "bash scripts/dev.sh --remote=wc-vue",
    "dev:iframe-vite": "bash scripts/dev.sh --remote=iframe-vite",
    "dev:iframe-nextjs": "bash scripts/dev.sh --remote=iframe-nextjs",
    "serve:remotes": "node scripts/serve-remotes.mjs",
    "build": "bash scripts/build-all.sh",
    "build:all": "bash scripts/build-all.sh",
    "typecheck": "bash scripts/typecheck-all.sh",
    "check:all": "bash scripts/typecheck-all.sh",
    "clean": "bash scripts/clean-all.sh",
    "clean:all": "bash scripts/clean-all.sh",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "ports:clean": "bash scripts/kill-ports.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  },
  "volta": {
    "node": "24.15.0"
  }
}
